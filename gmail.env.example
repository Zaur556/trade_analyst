# Copy this file to %USERPROFILE%\.commodity-agent\gmail.env (preferred, not
# synced by OneDrive) or to the project-root gmail.env.
# NEVER commit gmail.env or paste your app password into chat.
#
# Gmail requires 2-Step Verification and an App Password:
#   https://myaccount.google.com/apppasswords
# Use the 16-character app password, not your normal Google password.
#
# You can also set these as Windows environment variables instead of using a file.

GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
ALERT_TO=you@gmail.com

# Optional: use port 587 with STARTTLS if 465 is blocked.
# GMAIL_SMTP_PORT=587
